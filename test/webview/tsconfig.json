{
  // Type-check program for the webview unit suite. vitest runs these files
  // through esbuild transpile-only, so without this gate every type-level
  // contract in test/webview (e.g. the branded SessionToken) is erased and
  // never enforced. This config type-checks them under the SAME compiler view
  // as the webview SOURCE (mirrors src/webview/tsconfig.json: ESM + bundler
  // resolution + DOM lib + vscode-webview types) so the tests see the exact
  // types the code they exercise is built with.
  //
  // Scope is test/webview plus the two cross-suite inputs named in `include`
  // (test/fixtures, test/shared/eol-pair-table.ts). The host-side unit suites
  // are type-checked by test/extension/tsconfig.unit.json, not here.
  //
  // noEmit (inherited): this is a CI gate, not a build step — vitest still
  // runs through its own transpiler. rootDir is the repo root so the
  // cross-layer files under ../../src/* stay inside the program's containment
  // boundary (TS6059) — it plays no part in resolving those imports, which is
  // moduleResolution's job.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    // The webview SOURCE is browser-only (node types are excluded from
    // src/webview/tsconfig.json), but a few test files here read source from
    // disk via `node:fs`/`node:path`/`node:url` for contract checks, so this
    // test-only program needs the node ambient module declarations. Declared
    // explicitly rather than relying on the test runner's type chain to pull
    // them in transitively (which vitest 4 no longer does).
    "types": ["vscode-webview", "node"],
    "rootDir": "../.."
  },
  "include": [
    "**/*.ts",
    // test/fixtures/ is CROSS-SUITE. Included explicitly so a fixture is in this
    // program whether or not a suite in this directory imports it.
    // test/extension/tsconfig.unit.json includes the directory too.
    "../fixtures/**/*.ts",
    // The EOL pair table is consumed by test/shared/ and
    // test/extension/session/. Both were in no tsconfig when this entry was
    // added, so nothing else gave it a program; test/extension/tsconfig.unit.json
    // holds all three now.
    "../shared/eol-pair-table.ts",
    "../../src/webview/**/*.ts",
    "../../src/markdown/**/*.ts",
    "../../src/shared/**/*.ts"
  ]
}
